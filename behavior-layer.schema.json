{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osi.example/schema/behavior-layer/0.2",
  "title": "OSI Behavior Layer Extension v0.2",
  "type": "object",
  "additionalProperties": true,
  "required": ["namespace", "behavior_layer_version", "action_types", "rules"],
  "properties": {
    "namespace": { "type": "string", "minLength": 1 },
    "behavior_layer_version": { "type": "string", "minLength": 1 },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "owner": { "type": "string" },
        "last_updated": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "action_types": {
      "type": "array",
      "items": { "$ref": "#/$defs/actionType" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "actionType": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "kind"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "全局唯一动作标识，建议 {dataset}/{action} 格式"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "面向用户的短标题（展示用）"
        },
        "description": {
          "type": "string",
          "description": "动作的业务语义说明"
        },
        "kind": {
          "type": "string",
          "enum": ["command", "query"],
          "description": "command=写操作, query=读/查询操作"
        },
        "entity_name": {
          "type": "string",
          "description": "指向的逻辑数据集名"
        },
        "io_schema": {
          "type": "object",
          "additionalProperties": true,
          "description": "输入/输出 JSON Schema",
          "properties": {
            "input_schema": { "type": "object", "description": "输入参数 Schema" },
            "output_schema": { "type": "object", "description": "输出结果 Schema" }
          }
        },
        "effects": {
          "type": "array",
          "description": "动作副作用，定义对 dataset/field 的读写影响",
          "items": { "$ref": "#/$defs/effect" }
        },
        "ai_context": {
          "type": "array",
          "items": { "type": "string" },
          "description": "自然语言触发示例（利于 AI 召回）"
        },
        "tool_hint": {
          "type": "object",
          "additionalProperties": true,
          "description": "工具/方言映射提示",
          "properties": {
            "tool_name": { "type": "string" },
            "dialect": { "type": "string", "enum": ["ANSI_SQL", "SNOWFLAKE", "DATABRICKS", "MDX", "TABLEAU"] }
          }
        },
        "label": {
          "type": "array",
          "items": { "type": "string" },
          "description": "能力标签"
        },
        "synonyms": {
          "type": "array",
          "items": { "type": "string" },
          "description": "动作别名（利于召回）"
        },
        "version": {
          "type": "string",
          "description": "动作自身版本号"
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": true,
      "required": ["entity", "mode", "impact_type"],
      "properties": {
        "entity": {
          "type": "string",
          "enum": ["dataset", "field"],
          "description": "作用对象类型"
        },
        "mode": {
          "type": "string",
          "enum": ["write", "derive"],
          "description": "读写模式"
        },
        "impact_type": {
          "type": "string",
          "enum": [
            "create_row",
            "update_row",
            "delete_row",
            "aggregate",
            "compute",
            "state_transition"
          ],
          "description": "影响类型"
        },
        "selectors": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "dataset": { "type": "string" },
            "field_names": { "type": "array", "items": { "type": "string" } }
          }
        },
        "set_value": {
          "description": "state_transition 时的新值"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "severity", "when", "constraint", "ai_context"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "全局唯一规则标识，建议 {namespace}/{rule_name} 格式"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "规则短标题（展示用）"
        },
        "description": {
          "type": "string",
          "description": "规则的详细说明"
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warn", "info"],
          "description": "error=阻止, warn=警告, info=提示"
        },
        "when": { "$ref": "#/$defs/when" },
        "if": {
          "type": "object",
          "additionalProperties": true,
          "description": "可选条件（any_of/all_of/not），用于更细粒度触发控制"
        },
        "constraint": { "$ref": "#/$defs/constraint" },
        "ai_context": {
          "type": "array",
          "items": { "type": "string" },
          "description": "面向用户/Agent 的违规提示文本数组"
        },
        "references": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true },
          "description": "参考链接列表"
        },
        "label": {
          "type": "array",
          "items": { "type": "string" },
          "description": "规则标签"
        }
      }
    },
    "when": {
      "type": "object",
      "additionalProperties": true,
      "required": ["entity"],
      "properties": {
        "entity": {
          "type": "string",
          "enum": ["action", "dataset", "field", "metric", "relationship"],
          "description": "触发实体的类型"
        },
        "applies_to": {
          "type": "object",
          "additionalProperties": true,
          "description": "当 entity=action 时使用",
          "properties": {
            "action_id": { "type": "string", "description": "触发的动作ID" }
          }
        },
        "selectors": {
          "type": "object",
          "additionalProperties": true,
          "description": "当 entity!=action 时使用",
          "properties": {
            "dataset": { "type": "string" },
            "field_names": { "type": "array", "items": { "type": "string" } },
            "metric_names": { "type": "array", "items": { "type": "string" } },
            "relationship_names": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "compliance",
            "governance",
            "risk",
            "policy",
            "control",
            "naming",
            "expression",
            "join",
            "filter",
            "security",
            "quality",
            "other"
          ],
          "description": "约束类型"
        },
        "requires": {
          "type": "array",
          "items": { "type": "string" },
          "description": "必须满足的条件表达式列表"
        },
        "forbidden": {
          "type": "array",
          "items": { "type": "string" },
          "description": "禁止的条件表达式列表"
        },
        "equals": {
          "description": "必须等于的值"
        },
        "pattern": {
          "type": "string",
          "description": "正则表达式（用于 naming 类型）"
        },
        "max_length": {
          "type": "number",
          "description": "最大长度限制"
        },
        "min_length": {
          "type": "number",
          "description": "最小长度限制"
        },
        "recommendation": {
          "type": "string",
          "description": "策略建议文本（用于 warn 级别）"
        },
        "refers_to": {
          "type": "string",
          "description": "引用字段路径（用于 control 类型）"
        }
      }
    }
  }
}
